<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Used by .github/workflows/testflight.yml: sign for App Store Connect and upload the build.
     The team ID is filled in from the APPLE_TEAM_ID secret at run time. -->
<plist version="1.0">
<dict>
    <key>method</key>
    <string>app-store-connect</string>
    <key>destination</key>
    <string>upload</string>
    <key>signingStyle</key>
    <string>manual</string>
    <key>signingCertificate</key>
    <string>Apple Distribution</string>
    <key>provisioningProfiles</key>
    <dict>
        <key>au.com.strapify.picklist</key>
        <string>Picklist App Store</string>
    </dict>
    <key>teamID</key>
    <string>TEAM_ID_PLACEHOLDER</string>
    <key>manageAppVersionAndBuildNumber</key>
    <false/>
</dict>
</plist>
